{
  "name": "tv-shows-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "preview": "vite preview",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "mobx": "^7.1.5",
    "mobx-react-lite": "^5.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "simple-git-hooks": {
    "pre-commit": "sh scripts/hooks/pre-commit.sh",
    "pre-push": "sh scripts/hooks/pre-push.sh"
  }
}
